# Copy this file to .env, then fill in the values from your Supabase
# project (Settings → API). See README.md for the full setup steps.

# Safe to expose to the browser — read access only, governed by
# db/schema.sql's RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOT safe to expose — this key bypasses RLS entirely. It's read only by
# the serverless functions in app/api/ (via `vercel dev` locally), never
# by Vite/the browser bundle, because it isn't VITE_-prefixed. Supabase
# project → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
