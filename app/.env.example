# Copy this file to .env, then fill in the two values from your Supabase
# project (Settings → API). Both are safe to expose to the browser — the
# anon key only has the access granted by db/schema.sql's RLS policies.
# See README.md for the full setup steps.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
